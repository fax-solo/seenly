<?xml version="1.0" encoding="utf-8"?>
<!-- All provider and image endpoints are HTTPS; cleartext HTTP is never allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
